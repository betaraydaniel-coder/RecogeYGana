# ──────────────────────────────────────────────────────────────────────────
# .gitignore estándar para proyectos Unity
# ──────────────────────────────────────────────────────────────────────────

# Carpetas autogeneradas por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Asset meta files que NO deben ignorarse (Unity los necesita)
# (no agregamos *.meta a la lista de ignore intencionadamente)

# Archivos de Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Resultados de builds locales
*.apk
*.aab
*.unitypackage
*.app

# Archivos generados por Python
__pycache__/
*.py[cod]

# Archivos del sistema operativo
.DS_Store
Thumbs.db
